{
  "Llm": {
    "Type": "<OpenAI | Anthropic>",
    "Endpoint": "<optional for OpenAI: empty = api.openai.com; https://openrouter.ai/api/v1 ; https://<resource>/openai/v1/>",
    "Model": "<model id or Azure deployment name>",
    "PolicyId": "",
    "Temperature": 0,
    "Seed": 20261007,
    "TimeoutSeconds": "",
    "Profiles": {
      "gpt41mini": {
        "Type": "<OpenAI>",
        "Endpoint": "<https://<resource>/openai/v1/>",
        "Model": "<the existing Azure deployment name (gpt-4.1-mini)>",
        "PolicyId": "",
        "Temperature": 0,
        "Seed": 20261007,
        "ReasoningEffort": ""
      },
      "gpt54mini": {
        "Type": "<OpenAI>",
        "Endpoint": "<https://<resource>/openai/v1/>",
        "Model": "<Azure deployment name (gpt-5.4-mini)>",
        "PolicyId": "",
        "Temperature": "",
        "Seed": "",
        "ReasoningEffort": ""
      },
      "gpt56luna": {
        "Type": "<OpenAI>",
        "Endpoint": "<https://<resource>/openai/v1/>",
        "Model": "<Azure deployment name (gpt-5.6-luna)>",
        "PolicyId": "",
        "Temperature": "",
        "Seed": "",
        "ReasoningEffort": ""
      },
      "haiku55": {
        "Type": "<Anthropic>",
        "Model": "<Anthropic model id (Claude Haiku 5.5)>",
        "Temperature": "",
        "Seed": "",
        "MaxOutputTokens": 16000,
        // Claude Haiku 5.5's list price in US dollars per million tokens, from Anthropic's pricing page: input, output, input read
        // from the prompt cache, input written to the one-hour cache. Prompts up to 100k tokens.
        "Pricing": {
          "Currency": "USD",
          "InputPerMillionTokens": 0.10,
          "OutputPerMillionTokens": 0.50,
          "CacheReadPerMillionTokens": 0.01,
          "CacheWritePerMillionTokens": 0.20
        }
      }
    }
  },
  "Books": {
    "DownloadTimeoutSeconds": 60
  },
  "Pricing": {
    "Currency": "",
    "InputPerMillionTokens": "",
    "OutputPerMillionTokens": ""
  },
  "Chat": {
    "Llm": "",
    "MaxRows": 80,
    "SearchMaxPerTerm": 40,
    "KnowledgePack": true,
    "RequireToolFirst": true,
    "CharacterGate": true,
    "Register": {
      "hound-of-the-baskervilles": "proper Victorian British English",
      "three-musketeers": "the register of Dumas in English translation",
      "treasure-island": "Stevenson's plain eighteenth-century English, with sailors' talk where it fits"
    }
  },
  "Indexing": {
    "Llm": "haiku55",
    "EvidenceThreshold": 0.9,
    "Chunk": {
      "Tokens": 8000,
      "ChapterAligned": true
    },
    "StageA": {
      "Glean": false,
      "Judge": true,
      "JudgeBand": "0.80-0.90",
      // decided on gold (the Hound, glean on, one run per setting, Stages 1-3). Entity F1 / Fact F1 on ch. 1-3:
      // default 0.706 / 0.220 (run 20261011T132311Z-ec8494), medium 0.742 / 0.270 (20261011T132313Z-859aeb),
      // low 0.615 / 0.178 (20261011T132318Z-4fbdf4 on the Stage 1 of 20261011T101150Z-0dc742), off 0.514 / 0.123 (20261011T132316Z-032b70).
      // Held-out ch. 8, entity F1: default 0.818 (20261011T132933Z-1e0eaf), medium 0.837 (20261011T132935Z-4df60b).
      // medium is the cheapest setting not below the model's default on either.
      "Thinking": "medium"
    },
    "StageB": {
      "MaxGroupsPerCall": 25,
      "Samples": 3,
      "MinVotes": 2
    },
    "Parallel": 8,
    "Cache": true,
    "Stage3": {
      "DedupeThreshold": 0.6
    },
    "Loop": {
      "Runs": 5
    },
    "Resolve": {
      "Similarity": "token-containment+jaro-winkler",
      "JaroWinklerThreshold": 0.88,
      "EvidencePerSide": 3
    }
  }
}
